---
import Logo from './Logo.astro';
import { uiFor, type Locale } from '../i18n';

const { locale = 'es' as Locale } = Astro.props;
const f = uiFor(locale).footer;
// Las páginas legales (privacidad/términos/cookies) aún son solo en español;
// los enlaces apuntan a ellas y las etiquetas se localizan.
const legalBase = '/';
---
<footer class="mt-20 border-t border-[#cdbda6] bg-[#231a17] text-[#efe4d4]">
  <div class="bridge-rule"></div>
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-12 lg:grid-cols-[1fr_1.25fr] lg:px-8">
    <div>
      <div class="rounded-2xl bg-[#fffaf1] p-4 inline-block"><Logo /></div>
      <p class="mt-5 max-w-xl text-sm text-[#d9cbbb]">{f.tagline}</p>
      <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a class="focus-ring underline hover:text-white" href={legalBase + 'privacidad/'}>{f.privacy}</a>
        <a class="focus-ring underline hover:text-white" href={legalBase + 'terminos/'}>{f.terms}</a>
        <a class="focus-ring underline hover:text-white" href={legalBase + 'cookies/'}>{f.cookies}</a>
      </div>
    </div>
    <div class="space-y-3 text-sm text-[#d9cbbb]">
      <p>{f.independent}</p>
      <p>{f.sources}</p>
      <p>{f.weather}</p>
      <p>{f.images}</p>
      <p>{f.updated}</p>
      <p class="pt-2 font-semibold text-white">{f.copyright}</p>
    </div>
  </div>
</footer>
