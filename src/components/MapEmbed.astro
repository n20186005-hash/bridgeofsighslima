---
import type { Locale } from '../i18n';
const { locale = 'es' as Locale } = Astro.props;
const t = locale === 'en'
  ? {
      title: 'Map of the Bridge of Sighs',
      sub: 'Jr. Batallón 271, Barranco 15063, Lima, Peru · Location code: VX2G+8X',
      ref: 'Reference: Jr. Batallón 271, Barranco 15063 · Plus Code VX2G+8X',
      link: 'Official Tourism Portal of Peru',
      iframeLang: 'en',
      titleAttr: 'Google map of the Bridge of Sighs in Barranco, Lima'
    }
  : {
      title: 'Mapa del Puente de los Suspiros',
      sub: 'Jr. Batallón 271, Barranco 15063, Lima, Perú · Código de ubicación: VX2G+8X',
      ref: 'Referencia: Jr. Batallón 271, Barranco 15063 · Código Plus VX2G+8X',
      link: 'Portal Oficial de Turismo del Perú',
      iframeLang: 'es',
      titleAttr: 'Mapa de Google del Puente de los Suspiros en Barranco, Lima'
    };
const iframeSrc =
  'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6937.533658877889!2d-77.0226004!3d-12.1491798!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105b7ed834fd9f9%3A0xb90fc20e31cc0a04!2z5Y-55oGv5LmL5qGl!5e1!3m2!1s' +
  t.iframeLang + '!2s';
---
<section aria-labelledby="mapa-titulo" class="overflow-hidden rounded-[2rem] border border-[#cdbda6] bg-white shadow-xl shadow-[#3c2a1d]/10">
  <div class="border-b border-[#e2d5c4] bg-[#fffaf1] px-6 py-5">
    <h3 id="mapa-titulo" class="serif text-2xl font-bold text-[#48151f]">{t.title}</h3>
    <p class="mt-1 text-sm text-[#65544a]">{t.sub}</p>
  </div>
  <iframe
    src={iframeSrc}
    width="100%"
    height="480"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    title={t.titleAttr}
  ></iframe>
  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-[#e2d5c4] bg-[#fffaf1] px-6 py-3 text-xs text-[#6b5a50]">
    <span>{t.ref}</span>
    <a href="https://www.peru.travel/es" target="_blank" rel="external noopener noreferrer" class="focus-ring font-bold text-[#6e2430] underline">{t.link}</a>
  </div>
</section>
