---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapEmbed from '../components/MapEmbed.astro';

const PHOTO_HERO = 'https://upload.wikimedia.org/wikipedia/commons/d/d4/PUENTE_DE_LOS_SUSPIROS.jpg';
const PHOTO_BRIDGE = 'https://upload.wikimedia.org/wikipedia/commons/6/6a/Puente_de_los_Suspiros%2C_Barranco.jpg';
const PHOTO_BAJADA = 'https://upload.wikimedia.org/wikipedia/commons/3/3d/Bajada_de_Ba%C3%B1os%2C_Barranco.jpg';
const PHOTO_ERMITA = 'https://upload.wikimedia.org/wikipedia/commons/6/66/Puente_de_los_Suspiros_Barranco.jpg';

const attractionUrl = Astro.site ? new URL('/#puente-de-los-suspiros', Astro.site).href : undefined;
const homeUrl = Astro.site ? new URL('/', Astro.site).href : undefined;

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LandmarksOrHistoricalBuildings'],
  ...(attractionUrl ? { '@id': attractionUrl } : {}),
  ...(homeUrl ? { url: homeUrl } : {}),
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Wikidata',
    value: 'Q42846429'
  },
  name: 'Puente de los Suspiros',
  alternateName: 'Puente de los Suspiros de Barranco',
  description: 'Puente histórico de madera ubicado sobre la Bajada de Baños, en la Zona Monumental de Barranco, Lima, Perú.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Jr. Batallón 271',
    addressLocality: 'Barranco',
    addressRegion: 'Lima',
    postalCode: '15063',
    addressCountry: 'PE'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -12.1491401,
    longitude: -77.022624
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '00:00',
    closes: '23:59'
  }],
  isAccessibleForFree: true,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '24561',
    bestRating: '5',
    worstRating: '1'
  },
  sameAs: [
    'https://www.gob.pe/institucion/munibarranco/campa%C3%B1as/98478-puente-de-los-suspiros-bridge-of-sighs',
    'https://munibarranco.gob.pe/portal/atractivos-turisticos/',
    'https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=5585',
    'https://www.wikidata.org/wiki/Q42846429',
    'https://target2.promperu.gob.pe/teapuntas-lima-callao/distritos-con-historia/barranco/puente-de-los-suspiros'
  ]
};

const faq = [
  ['¿Cuesta entrar al Puente de los Suspiros?', 'No. El Inventario Nacional de Recursos Turísticos de MINCETUR y la ficha de PROMPERÚ señalan ingreso libre.'],
  ['¿Cuál es el horario de visita?', 'La ficha actual de Google Maps muestra el puente como abierto las 24 horas. El Inventario Nacional de Recursos Turísticos de MINCETUR conserva, en cambio, una franja de visita de referencia de 08:00 a 20:00. Ante esta diferencia, conviene tomar 08:00–20:00 como franja turística de referencia y revisar avisos municipales si hay obras, eventos o restricciones.'],
  ['¿Cómo llegar en transporte público?', 'Una ruta documentada por MINCETUR parte de la Estación Central del Metropolitano hacia la Estación Boulevard; desde allí se continúa a pie aproximadamente 450 metros hasta el puente.'],
  ['¿El Puente de los Suspiros tiene estacionamiento?', 'El puente no dispone de estacionamiento propio. Está dentro de una zona histórica con calles estrechas y alta circulación peatonal, por lo que suele ser más práctico llegar en transporte público, taxi o movilidad por aplicación y completar el último tramo caminando.'],
  ['¿Cuánto tiempo conviene dedicarle?', 'Para ver el puente, recorrer la Bajada de Baños y hacer fotografías, una visita de 45 a 90 minutos suele ser suficiente. Si se combina con la Ermita, el Parque Municipal y miradores de Barranco, conviene reservar entre dos y tres horas.'],
  ['¿Cuál es la tradición del deseo?', 'La tradición popular cuenta que quien cruza el puente conteniendo la respiración mientras piensa en un deseo puede verlo cumplido. Es una leyenda local, no un hecho histórico.']
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(([q, a]) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a }
  }))
};
---
<BaseLayout
  title="Puente de los Suspiros en Barranco, Lima | Guía de visita"
  description="Guía independiente del Puente de los Suspiros de Barranco: historia, entrada, horario, cómo llegar, mapa, gastronomía, estacionamiento y lugares cercanos."
  structuredData={[placeSchema, faqSchema]}
>
  <section class="relative isolate min-h-[76vh] overflow-hidden bg-[#241a17] text-white">
    <img src={PHOTO_HERO} alt="Puente de los Suspiros de Barranco visto entre sus barandas de madera y edificios históricos" class="absolute inset-0 h-full w-full object-cover opacity-60" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#2d1519]/95 via-[#2d1519]/70 to-transparent"></div>
    <div class="relative mx-auto flex min-h-[76vh] max-w-7xl items-end px-5 py-16 lg:px-8 lg:py-20">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex rounded-full border border-white/30 bg-black/20 px-4 py-2 text-xs font-bold uppercase tracking-[.2em] backdrop-blur">Barranco · Lima · Perú</p>
        <h1 class="serif text-5xl font-bold leading-[.98] text-white sm:text-6xl lg:text-8xl">Puente de los Suspiros</h1>
        <p class="mt-6 max-w-2xl text-lg text-[#f8ead4] sm:text-xl">Un puente de madera de 1876 suspendido sobre la Bajada de Baños, convertido en símbolo del Barranco bohemio, la memoria urbana y la música de Chabuca Granda.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#visita" class="focus-ring rounded-full bg-[#d89a2b] px-6 py-3 font-bold text-[#2b1d17] no-underline hover:bg-[#efb950]">Planear la visita</a>
          <a href="#historia" class="focus-ring rounded-full border border-white/60 bg-white/10 px-6 py-3 font-bold text-white no-underline backdrop-blur hover:bg-white/20">Conocer su historia</a>
        </div>
        <p class="mt-5 text-xs text-[#e6d8c8]">Fotografía real: HLaiza, Wikimedia Commons, licencia CC BY-SA 4.0.</p>
      </div>
    </div>
  </section>

  <section class="border-b border-[#d8c8b2] bg-[#fffaf1]">
    <div class="mx-auto max-w-7xl px-5 pt-6 lg:px-8">
      <div class="flex flex-col gap-3 rounded-2xl border border-[#d9b65d] bg-[#fff3c9] p-5 text-[#4a351d] sm:flex-row sm:items-center sm:justify-between">
        <p><strong>Estado actual:</strong> el paso peatonal fue reabierto en agosto de 2026 tras seis meses de trabajos de conservación y reforzamiento, con nueva iluminación y recuperación de elementos de madera.</p>
        <a href="https://andina.pe/agencia/galeria-puente-los-suspiros-reabrio-tras-seis-meses-trabajos-conservacion-sus-150-anos-30238.aspx" target="_blank" rel="external noopener noreferrer" class="focus-ring shrink-0 font-bold text-[#6e2430] underline">Ver fuente</a>
      </div>
    </div>
    <div class="mx-auto mt-6 grid max-w-7xl grid-cols-2 gap-px bg-[#d8c8b2] md:grid-cols-4">
      <div class="bg-[#fffaf1] p-6"><span class="block text-xs font-bold uppercase tracking-[.16em] text-[#6e2430]">Valoración</span><strong class="serif mt-1 block text-3xl text-[#2b1d17]">4,5 / 5</strong><small class="text-[#6b5a50]">24.561 reseñas en la ficha facilitada</small></div>
      <div class="bg-[#fffaf1] p-6"><span class="block text-xs font-bold uppercase tracking-[.16em] text-[#6e2430]">Acceso</span><strong class="serif mt-1 block text-3xl text-[#2b1d17]">Libre</strong><small class="text-[#6b5a50]">Sin entrada de pago</small></div>
      <div class="bg-[#fffaf1] p-6"><span class="block text-xs font-bold uppercase tracking-[.16em] text-[#6e2430]">Acceso publicado</span><strong class="serif mt-1 block text-3xl text-[#2b1d17]">24 horas</strong><small class="text-[#6b5a50]">Google Maps; MINCETUR registra 08:00–20:00</small></div>
      <div class="bg-[#fffaf1] p-6"><span class="block text-xs font-bold uppercase tracking-[.16em] text-[#6e2430]">Entorno</span><strong class="serif mt-1 block text-3xl text-[#2b1d17]">Zona Monumental</strong><small class="text-[#6b5a50]">Centro histórico de Barranco</small></div>
    </div>
  </section>

  <section id="historia" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid items-start gap-12 lg:grid-cols-[1.05fr_.95fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[.18em] text-[#24574d]">Historia del Puente de los Suspiros</p>
        <h2 class="serif mt-3 text-4xl font-bold leading-tight text-[#48151f] sm:text-5xl">Una pasarela que terminó definiendo el paisaje de Barranco</h2>
        <div class="mt-7 space-y-5 text-lg text-[#4e4037]">
          <p>La Municipalidad Distrital de Barranco sitúa la construcción del puente en 1876, durante la gestión de Francisco García Monterroso. Su función era práctica: unir los extremos de la quebrada y facilitar el paso entre los sectores de Ayacucho y la Ermita.</p>
          <p>El puente sufrió daños durante la Guerra del Pacífico y fue reparado en distintas etapas. En 2014 se realizó una restauración integral que reforzó la pasarela con madera de huayruro e incorporó iluminación. En 2026 concluyó una nueva intervención de conservación y reforzamiento, tras la cual el paso peatonal volvió a abrir al público. Su imagen quedó además ligada a la obra de Chabuca Granda, que dedicó una célebre composición al lugar.</p>
          <p>Hoy forma parte del corazón de la Zona Monumental de Barranco y aparece en el Inventario Nacional de Recursos Turísticos del Perú como un recurso cultural de arquitectura y espacios urbanos.</p>
        </div>
        <div class="mt-8 rounded-2xl border-l-4 border-[#d89a2b] bg-[#fffaf1] p-6 shadow-sm">
          <h3 class="serif text-2xl font-bold text-[#48151f]">La leyenda, separada de la historia</h3>
          <p class="mt-2 text-[#56463c]">La tradición popular invita a cruzar el puente sin respirar mientras se piensa en un deseo. Es parte del imaginario de Barranco y debe entenderse como una leyenda, no como un dato histórico comprobado.</p>
        </div>
      </div>
      <figure class="overflow-hidden rounded-[2rem] bg-[#291e19] shadow-2xl shadow-[#473125]/20">
        <img src={PHOTO_BRIDGE} alt="Estructura de madera del Puente de los Suspiros en Barranco" class="aspect-[4/5] w-full object-cover" loading="lazy" />
        <figcaption class="p-4 text-xs text-[#e6d8c8]">Fotografía real: Ivan Brehaut L., Wikimedia Commons, CC BY-SA 4.0.</figcaption>
      </figure>
    </div>
  </section>

  <section id="visita" class="bg-[#24574d] text-white">
    <div class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[.18em] text-[#f1c365]">Información práctica</p>
      <h2 class="serif mt-3 max-w-3xl text-4xl font-bold sm:text-5xl">Visitar el Puente de los Suspiros sin perder lo esencial</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/20"><span class="text-3xl">◌</span><h3 class="serif mt-3 text-2xl font-bold">Entrada y costo</h3><p class="mt-2 text-[#e7f0ed]">El acceso al puente es libre. No hay boletería para cruzarlo ni tarifa de ingreso registrada por MINCETUR.</p></article>
        <article class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/20"><span class="text-3xl">◷</span><h3 class="serif mt-3 text-2xl font-bold">Mejor momento</h3><p class="mt-2 text-[#e7f0ed]">La tarde ofrece una luz agradable para fotografía y permite continuar hacia los miradores de Barranco. Las primeras horas suelen ser más tranquilas.</p></article>
        <article class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/20"><span class="text-3xl">⌁</span><h3 class="serif mt-3 text-2xl font-bold">Tiempo sugerido</h3><p class="mt-2 text-[#e7f0ed]">Dedica entre 45 y 90 minutos al puente y la Bajada de Baños; reserva dos o tres horas si ampliarás el paseo por el Barranco histórico.</p></article>
        <article class="rounded-3xl bg-white/10 p-6 ring-1 ring-white/20"><span class="text-3xl">P</span><h3 class="serif mt-3 text-2xl font-bold">Estacionamiento</h3><p class="mt-2 text-[#e7f0ed]">No dispone de estacionamiento propio. Por el carácter peatonal e histórico del entorno, es preferible llegar sin auto cuando sea posible.</p></article>
      </div>
      <p class="mt-7 text-sm text-[#d5e5df]"><strong>Horarios:</strong> Google Maps muestra actualmente acceso 24 horas; el inventario turístico de MINCETUR registra como franja de visita 08:00–20:00. Para planificar una visita, usa esa franja como referencia conservadora y revisa avisos municipales si hay mantenimiento, eventos o cierres temporales.</p>
    </div>
  </section>

  <section id="como-llegar" class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="text-sm font-bold uppercase tracking-[.18em] text-[#24574d]">Transporte y acceso</p>
        <h2 class="serif mt-3 text-4xl font-bold text-[#48151f] sm:text-5xl">Cómo llegar al Puente de los Suspiros</h2>
        <div class="mt-8 space-y-4">
          <div class="rounded-2xl border border-[#d8c8b2] bg-[#fffaf1] p-6"><h3 class="font-bold text-[#48151f]">En Metropolitano</h3><p class="mt-2 text-[#54463e]">MINCETUR documenta una ruta desde la Estación Central hasta la Estación Boulevard. Desde Boulevard se continúa a pie unos 450 m, aproximadamente 10 minutos.</p></div>
          <div class="rounded-2xl border border-[#d8c8b2] bg-[#fffaf1] p-6"><h3 class="font-bold text-[#48151f]">En taxi o movilidad por aplicación</h3><p class="mt-2 text-[#54463e]">Indica “Puente de los Suspiros, Barranco” o “Jr. Batallón 271”. En horas de alta demanda conviene bajar cerca del Parque Municipal y completar el tramo a pie.</p></div>
          <div class="rounded-2xl border border-[#d8c8b2] bg-[#fffaf1] p-6"><h3 class="font-bold text-[#48151f]">A pie dentro de Barranco</h3><p class="mt-2 text-[#54463e]">El puente está a dos cuadras del Parque Municipal según la ficha de MINCETUR. Es un recorrido corto por el núcleo histórico y peatonal del distrito.</p></div>
        </div>
      </div>
      <MapEmbed />
    </div>
  </section>

  <section id="alrededores" class="bg-[#fffaf1] py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-[.18em] text-[#24574d]">Alrededores inmediatos</p>
          <h2 class="serif mt-3 text-4xl font-bold text-[#48151f] sm:text-5xl">Un paseo que continúa bajo el puente</h2>
          <p class="mt-5 max-w-2xl text-lg text-[#594a41]">La Municipalidad de Barranco agrupa el puente con una serie de espacios culturales del circuito histórico. La Bajada de Baños es el eje natural para seguir caminando hacia casonas, arte, gastronomía y vistas hacia la Costa Verde.</p>
        </div>
        <figure class="overflow-hidden rounded-[2rem] bg-[#291e19]"><img src={PHOTO_BAJADA} alt="Bajada de Baños de Barranco, camino histórico que pasa bajo el Puente de los Suspiros" class="aspect-[16/10] w-full object-cover" loading="lazy" /><figcaption class="p-4 text-xs text-[#e6d8c8]">Fotografía real: Nina Zaitceva, Wikimedia Commons, CC BY-SA 4.0.</figcaption></figure>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">Bajada de Baños</h3><p class="mt-2 text-[#5c4d44]">El antiguo sendero de la quebrada discurre bajo el puente y conecta el centro de Barranco con el sector costero.</p></article>
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">La Ermita de Barranco</h3><p class="mt-2 text-[#5c4d44]">Templo histórico que forma parte del paisaje inmediato del puente y del conjunto monumental del distrito.</p></article>
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">Parque Municipal</h3><p class="mt-2 text-[#5c4d44]">Punto de referencia central para iniciar una caminata por el Barranco histórico y acceder al puente.</p></article>
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">Plazuela Chabuca Granda</h3><p class="mt-2 text-[#5c4d44]">Espacio vinculado a la memoria de la compositora peruana cuya obra está íntimamente asociada al puente.</p></article>
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">Mirador Catalina Recavarren</h3><p class="mt-2 text-[#5c4d44]">Mirador del circuito histórico con perspectiva hacia la Costa Verde y el borde costero de Barranco.</p></article>
        <article class="rounded-3xl border border-[#d8c8b2] p-6"><h3 class="serif text-2xl font-bold text-[#48151f]">Antigua estación del Funicular</h3><p class="mt-2 text-[#5c4d44]">Vestigio del antiguo sistema que conectaba la parte alta de Barranco con la zona de playa.</p></article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-5 py-20 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2">
      <figure class="overflow-hidden rounded-[2rem] bg-[#291e19] shadow-xl"><img src={PHOTO_ERMITA} alt="Puente de los Suspiros con palmeras y la Ermita de Barranco al fondo" class="aspect-square w-full object-cover" loading="lazy" /><figcaption class="p-4 text-xs text-[#e6d8c8]">Fotografía real: Herwarth Morales, Wikimedia Commons, CC BY-SA 4.0.</figcaption></figure>
      <div>
        <p class="text-sm font-bold uppercase tracking-[.18em] text-[#24574d]">Sabores de Barranco</p>
        <h2 class="serif mt-3 text-4xl font-bold text-[#48151f] sm:text-5xl">Qué comer cerca del puente</h2>
        <p class="mt-5 text-lg text-[#594a41]">La propia oficina de turismo de Barranco presenta la gastronomía como una de las rutas del distrito, y la Bajada de Baños reúne cafés, tabernas y espacios para comer. Esta guía no recibe pagos ni comisiones de establecimientos.</p>
        <div class="mt-7 grid grid-cols-2 gap-3 text-sm font-semibold text-[#4d4039] sm:grid-cols-3">
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Ceviche</span>
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Tiradito</span>
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Anticuchos</span>
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Causa limeña</span>
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Picarones</span>
          <span class="rounded-full border border-[#d8c8b2] bg-[#fffaf1] px-4 py-3 text-center">Pisco sour</span>
        </div>
        <p class="mt-5 text-sm text-[#6b5b51]">Consejo: compara menús y precios visibles antes de pedir y confirma al establecimiento cualquier necesidad alimentaria.</p>
      </div>
    </div>
  </section>

  <section class="bg-[#6e2430] py-16 text-white">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[.18em] text-[#f1c365]">Fuentes públicas y asociación de entidad</p>
      <h2 class="serif mt-3 max-w-4xl text-4xl font-bold">Fuentes para verificar la información del Puente de los Suspiros</h2>
      <p class="mt-4 max-w-3xl text-[#f1dfe2]">Para evitar confundir este lugar con otros “Puentes de los Suspiros”, la guía utiliza el nombre oficial, la dirección de Barranco, coordenadas, referencias patrimoniales y enlaces directos a fuentes públicas peruanas.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a href="https://www.gob.pe/institucion/munibarranco/campa%C3%B1as/98478-puente-de-los-suspiros-bridge-of-sighs" target="_blank" rel="external noopener noreferrer" class="focus-ring rounded-2xl border border-white/25 bg-white/10 p-5 no-underline hover:bg-white/15"><strong class="block">Municipalidad Distrital de Barranco · ficha del puente</strong><span class="mt-1 block text-sm text-[#f1dfe2]">Historia, restauraciones y condición de ícono turístico.</span></a>
        <a href="https://munibarranco.gob.pe/portal/atractivos-turisticos/" target="_blank" rel="external noopener noreferrer" class="focus-ring rounded-2xl border border-white/25 bg-white/10 p-5 no-underline hover:bg-white/15"><strong class="block">Municipalidad de Barranco · atractivos turísticos</strong><span class="mt-1 block text-sm text-[#f1dfe2]">Dimensiones, material, contexto histórico y tradición local.</span></a>
        <a href="https://consultasenlinea.mincetur.gob.pe/fichaInventario/index.aspx?cod_Ficha=5585" target="_blank" rel="external noopener noreferrer" class="focus-ring rounded-2xl border border-white/25 bg-white/10 p-5 no-underline hover:bg-white/15"><strong class="block">MINCETUR · Inventario Nacional de Recursos Turísticos</strong><span class="mt-1 block text-sm text-[#f1dfe2]">Registro 5585, acceso, horario, ubicación y ruta de llegada.</span></a>
        <a href="https://www.wikidata.org/wiki/Q42846429" target="_blank" rel="external noopener noreferrer" class="focus-ring rounded-2xl border border-white/25 bg-white/10 p-5 no-underline hover:bg-white/15"><strong class="block">Wikidata · Q42846429</strong><span class="mt-1 block text-sm text-[#f1dfe2]">Identificador de entidad, ubicación y coordenadas geográficas.</span></a>
