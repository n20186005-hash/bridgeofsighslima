---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada (404) | Guía del Puente de los Suspiros" description="La página que buscas no existe o ha cambiado de ubicación en la guía del Puente de los Suspiros." noindex>
  <section class="mx-auto max-w-3xl px-5 py-24 text-center lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[.18em] text-[#24574d]">Error 404</p>
    <h1 class="serif mt-3 text-6xl font-bold text-[#48151f]">Página no encontrada</h1>
    <p class="mt-6 text-lg text-[#594a41]">La dirección que buscas no existe o el contenido cambió de lugar. Puedes volver al inicio de la guía o usar el índice de secciones para encontrar lo que necesitas.</p>
    <a href="/" class="focus-ring mt-8 inline-block rounded-full bg-[#6e2430] px-7 py-3 font-bold text-white no-underline hover:bg-[#48151f]">Volver a la guía del Puente de los Suspiros</a>
  </section>
</BaseLayout>
